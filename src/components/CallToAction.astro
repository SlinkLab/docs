---
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  primaryAction: {
    text: string;
    href: string;
    icon?: string;
  };
  secondaryAction?: {
    text: string;
    href: string;
    icon?: string;
  };
}

const { title, description, primaryAction, secondaryAction } = Astro.props;
---

<section class="home-cta not-content" aria-labelledby="ready-to-host">
  <div class="cta-copy">
    <h2 id="ready-to-host">{title}</h2>
    <p>{description}</p>
  </div>
  <div class="cta-actions">
    <Button
      variant="primary"
      href={primaryAction.href}
      icon={primaryAction.icon}
      size="lg"
      class="w-full sm:w-auto px-6 py-3 font-medium"
    >
      {primaryAction.text}
    </Button>
    {secondaryAction && (
      <Button
        variant="secondary"
        href={secondaryAction.href}
        icon={secondaryAction.icon}
        external={true}
        size="lg"
        class="w-full sm:w-auto px-6 py-3 font-medium"
      >
        {secondaryAction.text}
      </Button>
    )}
  </div>
</section>

<style>
  .home-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    margin-block-end: 2rem;
    border: 1px solid var(--home-line);
    border-radius: 0.75rem;
    background: var(--home-mist);
    text-align: center;
  }

  .cta-copy {
    max-width: 40rem;
  }

  h2 {
    margin: 0;
    color: var(--home-ink);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  p {
    margin-block: 0.75rem 0;
    color: var(--home-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (max-width: 40rem) {
    .home-cta {
      padding: 2rem 1.5rem;
    }

    .cta-actions {
      flex-direction: column;
      width: 100%;
      max-width: 22rem;
    }
  }
</style>
